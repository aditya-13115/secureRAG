# ============================================================
# GROQ
# ============================================================

# Comma-separated Groq API keys.
#
# IMPORTANT:
# Do not commit real keys.
GROQ_API_KEYS=your_key_1,your_key_2,your_key_3

# Fallback for a single key:
# GROQ_API_KEY=your_single_key

# Current configurable model.
GROQ_MODEL=openai/gpt-oss-120b

GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1200
GROQ_TIMEOUT_SECONDS=60

# Temporary cooldown after connection/server failures.
GROQ_TRANSIENT_COOLDOWN_SECONDS=3

# Retrieval/context settings.
RAG_TOP_K=8
RAG_CANDIDATE_K=30
RAG_MAX_CONTEXT_CHARS=28000